# Login credentials for the single shared account
APP_EMAIL=you@example.com
APP_PASSWORD=change-me-to-a-long-password

# Secret used to sign session cookies (any random string, 32+ chars)
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32

# Where the SQLite database lives (inside Docker this is /data)
# DATA_DIR=./data
